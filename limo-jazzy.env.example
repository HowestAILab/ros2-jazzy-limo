# ros2-jazzy-limo configuration, installed as /etc/limo-jazzy/limo-jazzy.env.
# This is the only file you need to edit. install.sh never overwrites it.
# After a change: sudo limo-jazzy restart

# --- Robot ---------------------------------------------------------------------------

# ROS namespace of this robot: topics become /<namespace>/scan, /<namespace>/odom, ...
# and every TF frame is prefixed with <namespace>/. Lowercase letters, digits, underscores.
LIMO_NAMESPACE=limo

# ROS domain. Also part of the container names (ros2-jazzy-<domain>-limo-...).
ROS_DOMAIN_ID=0

# Components started by `limo-jazzy start` and at boot (`limo-jazzy enable`):
#   base         motor controller, odometry, IMU (limo_base)
#   lidar        YDLidar -> /<namespace>/scan
#   camera       Orbbec depth camera -> /<namespace>/limo_camera/...
#   compressor   compressed republish of the color image
#   description  robot_state_publisher / joint_state_publisher (URDF, TF)
#   mapping      slam_toolbox, build a new map
#   localization slam_toolbox, localize in LIMO_SLAM_MAP
LIMO_COMPONENTS="base lidar camera compressor description"

# --- foxglove_bridge (WebSocket for Foxglove Studio) ------------------------------
# true: start the bridge together with the components. Override per start with
# `limo-jazzy start --bridge` or `limo-jazzy start --no-bridge`.
LIMO_FOXGLOVE_BRIDGE=true
LIMO_FOXGLOVE_PORT=8765

# --- DDS discovery (CycloneDDS) ------------------------------------------------------

# Static peers: IP addresses or hostnames of the other ROS 2 machines, separated by
# spaces. Needed when the network blocks multicast (common on Wi-Fi). Unreachable peers
# are harmless; list the addresses of every network the robot may join.
#   LIMO_DDS_PEERS="192.168.1.10 192.168.1.20 my-laptop.local"
LIMO_DDS_PEERS=""

# Network interface DDS binds to. Binding by name (not IP) keeps working when the robot
# moves to another Wi-Fi network. Empty = let CycloneDDS choose.
LIMO_DDS_INTERFACE=wlan0

# Multicast discovery: true, false, or spdp (multicast for discovery only).
LIMO_DDS_MULTICAST=spdp

# Full override: a CycloneDDS XML file (must be under /etc/limo-jazzy/) or inline XML.
# When set, LIMO_DDS_PEERS, LIMO_DDS_INTERFACE and LIMO_DDS_MULTICAST are ignored.
#   LIMO_CYCLONEDDS_URI=file:///etc/limo-jazzy/cyclonedds.xml
LIMO_CYCLONEDDS_URI=

# --- Hardware and tuning --------------------------------------------------------------

# Motor controller serial port, without /dev/.
LIMO_BASE_PORT=ttyTHS0
LIMO_CAMERA_FPS=15
# base_footprint -> base_link z in the URDF, metres (vendor value 0.15).
LIMO_GROUND_CLEARANCE=0.15
# low (decimated meshes) or high (original CAD meshes).
LIMO_MESH_DETAIL=low

# Saved slam_toolbox map for the localization component, without extension.
# Maps live in /var/lib/limo-jazzy/maps (mounted in every container).
LIMO_SLAM_MAP=
