<?xml version="1.0"?>
<package format="3">
  <name>limo_jazzy_bringup</name>
  <version>0.1.0</version>
  <description>Namespaced ROS 2 Jazzy bringup for the AgileX Limo Pro (base, lidar, camera, description, SLAM).</description>
  <maintainer email="noreply@example.com">ros2-jazzy-limo maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>limo_base</exec_depend>
  <exec_depend>limo_bringup</exec_depend>
  <exec_depend>limo_description</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
